# Tuned for the multi-stage Dockerfile at the repo root, which builds FROM
# SOURCE inside the image.
#
# Backstage's scaffold ships a .dockerignore that excludes packages/*/src and
# plugins, because its own packages/backend/Dockerfile is a host build that
# copies in a prebuilt bundle. Excluding source here instead makes `yarn tsc`
# fail with "TS18003: No inputs were found in config file".
.git
# Nested repositories keep their own .git, and the bare `.git` pattern above
# only matches the context root.
**/.git
.github
node_modules
packages/*/node_modules
plugins/*/node_modules
# A separate 1.5 GB git repository that happens to live in this directory. It is
# gitignored, so it never reaches a commit — but .gitignore has no bearing on the
# Docker build context, and without this line every `docker build` uploads all
# 1.5 GB to the daemon before the first instruction runs.
RTXsample
.yarn/cache
.yarn/install-state.gz
dist
dist-types
coverage

# Local config may hold tokens — never bake it into an image.
*.local.yaml

# Not needed at build time.
terraform
deploy
docs
*.md
